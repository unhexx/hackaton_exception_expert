# Необязательный файл: стенд стартует и без него.
# Точка входа сама пишет PRODUCT_SECRET в том, если переменная короче 32 символов.
# Скопируйте в compose.env, только если нужен свой секрет. Файл в git не входит.
# Пароль демо можно оставить пустым.
PRODUCT_SECRET=
PRODUCT_DEMO_PASSWORD=
PRODUCT_COOKIE_SECURE=0
