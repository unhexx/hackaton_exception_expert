  "paths": {
    "/api/auth/register": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Register",
        "operationId": "register_api_auth_register_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true,
                "examples": {
                  "candidate": {
                    "value": {
                      "email": "seeker@example.com",
                      "password": "password-ok",
                      "role": "candidate",
                      "consent": true
                    }
                  }
                },
                "title": "Payload"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {},
                "example": {
                  "code": "123456"
                }
              }
            }
          },
          "409": {
            "content": {
              "application/json": {
                "example": {
                  "error": "email_taken",
                  "message": "Почта уже зарегистрирована"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "example": {
                  "error": "consent_required",
                  "message": "Нужно явное согласие"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        }
      }
    },
